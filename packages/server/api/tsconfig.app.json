{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "types": ["node"],
    "allowJs": true,
    "baseUrl": "../../..",
    "paths": {
      "@activepieces/engine": ["packages/server/engine/src/main.ts"],
      "@activepieces/piece-*": ["packages/pieces/community/*/src/index.ts", "packages/pieces/core/*/src/index.ts"],
      "@activepieces/pieces-common": ["packages/pieces/common/src/index.ts"],
      "@activepieces/pieces-framework": ["packages/pieces/framework/src/index.ts"],
      "@activepieces/server-utils": ["packages/server/utils/dist/src/index.d.ts"],
      "@activepieces/shared": ["packages/shared/dist/src/index.d.ts"],
      "@veritly/contracts": ["../veritly-contracts/typescript/src/index.ts"],
      "@veritly/contracts/*": ["../veritly-contracts/typescript/src/*"]
    }
  },
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
